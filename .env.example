### JUPYTER ###

# Jupyter Lab
JUPYTER_HOST=0.0.0.0
JUPYTER_PORT=8888

### MLFLOW ###

# Postgres
MLFLOW_POSTGRES_USER=
MLFLOW_POSTGRES_PASSWORD=
MLFLOW_POSTGRES_DB=mlflow

# RustFS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLFLOW_RUSTFS_HOST=0.0.0.0
MLFLOW_RUSTFS_PORT=9000
MLFLOW_RUSTFS_CONSOLE_PORT=9001
MLFLOW_RUSTFS_CONSOLE_ENABLE=true
MLFLOW_RUSTFS_BUCKET=mlflow

# MLflow Server
MLFLOW_BACKEND_STORE_URI=postgresql://${MLFLOW_POSTGRES_USER}:${MLFLOW_POSTGRES_PASSWORD}@mlflow-postgres:5432/${MLFLOW_POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${MLFLOW_RUSTFS_BUCKET}/
MLFLOW_S3_ENDPOINT_URL=http://mlflow-rustfs:${MLFLOW_RUSTFS_PORT}
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_SERVER_ALLOWED_HOSTS=127.0.0.1:${MLFLOW_PORT},mlflow-server:${MLFLOW_PORT}
MLFLOW_TRACKING_URI=http://mlflow-server:${MLFLOW_PORT}

### PREFECT ###

# Postgres
PREFECT_POSTGRES_USER=
PREFECT_POSTGRES_PASSWORD=
PREFECT_POSTGRES_DB=prefect

# Redis
PREFECT_REDIS_MESSAGING_HOST=prefect-redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0

# Prefect Server
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_POSTGRES_USER}:${PREFECT_POSTGRES_PASSWORD}@prefect-postgres:5432/${PREFECT_POSTGRES_DB}
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_API_PORT=4200
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_SERVER_ANALYTICS_ENABLED=false
PREFECT_API_URL=http://prefect-server:${PREFECT_SERVER_API_PORT}/api
