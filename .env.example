### JUPYTER ###

JUPYTER_HOST=0.0.0.0
JUPYTER_PORT=8888

### RUSTFS ###

RUSTFS_HOST=0.0.0.0
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_CONSOLE_ENABLE=true

### AWS ###

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=http://rustfs-server:${RUSTFS_PORT}

### MLFLOW ###

# Postgres
MLFLOW_POSTGRES_USER=
MLFLOW_POSTGRES_PASSWORD=
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_POSTGRES_PORT=5432

# RustFS
MLFLOW_BUCKET=mlflow

# MLflow Server
MLFLOW_BACKEND_STORE_URI=postgresql://${MLFLOW_POSTGRES_USER}:${MLFLOW_POSTGRES_PASSWORD}@mlflow-postgres:${MLFLOW_POSTGRES_PORT}/${MLFLOW_POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${MLFLOW_BUCKET}/
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_SERVER_ALLOWED_HOSTS=127.0.0.1:${MLFLOW_PORT},mlflow-server:${MLFLOW_PORT}
MLFLOW_TRACKING_URI=http://mlflow-server:${MLFLOW_PORT}

### PREFECT ###

# Postgres
PREFECT_POSTGRES_USER=
PREFECT_POSTGRES_PASSWORD=
PREFECT_POSTGRES_DB=prefect
PREFECT_POSTGRES_PORT=5432

# Redis
PREFECT_REDIS_MESSAGING_HOST=prefect-redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0

# Prefect Server
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_POSTGRES_USER}:${PREFECT_POSTGRES_PASSWORD}@prefect-postgres:${PREFECT_POSTGRES_PORT}/${PREFECT_POSTGRES_DB}
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_API_PORT=4200
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_SERVER_ANALYTICS_ENABLED=false
PREFECT_API_URL=http://prefect-server:${PREFECT_SERVER_API_PORT}/api

### EVIDENTLY ###

# RustFS
EVIDENTLY_BUCKET=evidently

# Evidently Server
EVIDENTLY_HOST=0.0.0.0
EVIDENTLY_PORT=8080

### MONITORING ###

# Postgres
MONITORING_POSTGRES_USER=
MONITORING_POSTGRES_PASSWORD=
MONITORING_POSTGRES_DB=monitoring
MONITORING_POSTGRES_PORT=5432

# Adminer
MONITORING_ADMINER_DEFAULT_SERVER=monitoring-postgres
MONITORING_ADMINER_PORT=8080

# Grafana
MONITORING_GF_SECURITY_ADMIN_USER=
MONITORING_GF_SECURITY_ADMIN_PASSWORD=
MONITORING_GF_SERVER_HTTP_ADDR=0.0.0.0
MONITORING_GF_SERVER_HTTP_PORT=3000
MONITORING_GF_ANALYTICS_REPORTING_ENABLED=false
